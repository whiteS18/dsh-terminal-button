{
  "name": "dsh-terminal-button",
  "version": "0.3.5",
  "description": "Embedded terminal for DeepSeek Harness: opens an in-app terminal panel in the right sidebar (DockKit) instead of spawning a system terminal window. Follows the DSH theme and starts in the session workspace root.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "terminal",
    "pty",
    "xterm",
    "cordis"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "frames.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whiteS18/dsh-terminal-button.git"
  },
  "bugs": "https://github.com/whiteS18/dsh-terminal-button/issues",
  "homepage": "https://github.com/whiteS18/dsh-terminal-button#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
