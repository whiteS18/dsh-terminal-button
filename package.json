{
  "name": "dsh-terminal-button",
  "version": "0.4.3",
  "description": "Extension for DeepSeek Harness's official terminal: renders it in an in-app bottom panel, redirects Desktop \"open terminal\" entry points into that panel, and exposes the dsh CLI inside terminals. No second PTY/xterm stack.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "terminal",
    "bottom-panel",
    "extension",
    "cordis"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-terminal-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-terminal"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whiteS18/dsh-terminal-button.git"
  },
  "bugs": "https://github.com/whiteS18/dsh-terminal-button/issues",
  "homepage": "https://github.com/whiteS18/dsh-terminal-button#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
